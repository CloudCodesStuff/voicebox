#===============================================================================
# Sift, environment
#
#   cp .env.example .env
#   npm run env:check        # tells you exactly what's missing and where to get it
#
# The marketing site runs with NONE of these set. Fill in the CORE block to use
# the app; the rest turn on individual features and can wait.
#===============================================================================


#-------------------------------------------------------------------------------
# CORE, required to sign in and collect feedback
#-------------------------------------------------------------------------------

# Postgres connection string.
# Fastest option: neon.com → new project → copy the pooled connection string.
DATABASE_URL="postgresql://user:password@host/sift?sslmode=require"

# Session signing secret. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth, console.cloud.google.com
#   1. APIs & Services → Credentials → Create credentials → OAuth client ID
#   2. Application type: Web application
#   3. Authorised JavaScript origin:  http://localhost:3000
#   4. Authorised redirect URI:       http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Public origin, no trailing slash. This is what gets baked into the widget
# install snippet, so it must be the URL customers will actually load from.
#
# On Vercel: leave this UNSET. It's auto-detected from Vercel's own
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL env vars (see src/env.ts,
# detectAppUrl), which always match your project's actual assigned domain and
# can't be mistyped. Only set it here to intentionally override that, or for
# local dev / a non-Vercel host.
NEXT_PUBLIC_APP_URL="http://localhost:3000"


#-------------------------------------------------------------------------------
# Legal identity                                             REQUIRED TO LAUNCH
#-------------------------------------------------------------------------------
# These four strings are interpolated into the Terms of Service, the Privacy
# Policy, the Data Processing Agreement, and the footer of every email you send.
#
# They are legally load-bearing, not branding:
#   - A contract with a brand name binds nobody. Use the registered entity.
#   - Terms without a governing law are of uncertain enforceability.
#   - CAN-SPAM requires a physical mailing address in commercial email.
#
# `npm run env:check` fails while any of these is still a placeholder.

NEXT_PUBLIC_LEGAL_ENTITY="Your Company LLC"
NEXT_PUBLIC_GOVERNING_LAW="the State of New Jersey"
NEXT_PUBLIC_VENUE="the state and federal courts of New Jersey"

# DO NOT PUT YOUR HOME ADDRESS HERE.
#
# This string is rendered publicly: on the Terms, the Privacy Policy, the DPA,
# and in the footer of every email you send. A residential address published
# that way cannot be taken back, gets scraped, and is a personal safety issue,
# not a paperwork one.
#
# CAN-SPAM §7704(a)(5) is satisfied by any of these, none of which is your home:
#   - a USPS PO Box registered to the business
#   - a private mailbox from a Commercial Mail Receiving Agency
#     (iPostal1, Anytime Mailbox, PostScan: roughly $10-20/month)
#   - your registered agent's address, if you form an LLC
#     (Northwest, Harbor Compliance and similar include this)
#
# Forming the LLC solves the entity line above at the same time, and puts a
# liability shield between the business and you personally, which matters more
# once real customers and real feedback data are involved.
NEXT_PUBLIC_POSTAL_ADDRESS="PO Box 000, Your Town, NJ 00000"


#-------------------------------------------------------------------------------
# AI ANALYSIS, sentiment, categories, summaries, and theme clustering
# Without this, feedback is still collected and displayed; analysis is paused
# and the dashboard says so explicitly.
#-------------------------------------------------------------------------------

# platform.deepseek.com → API keys. The model is deepseek-v4-flash.
#
# PRIVACY: only the message text, the chosen type, and the rating are ever sent
# to the model. The submitter's email address and any identify() traits are
# deliberately excluded, see src/server/ai/analyze.ts.
DEEPSEEK_API_KEY=""


#-------------------------------------------------------------------------------
# EMAIL, weekly insight digests and account notices
#-------------------------------------------------------------------------------

# resend.com → API Keys
RESEND_API_KEY=""

# Must be a domain verified in Resend (Domains → Add domain → set DNS records).
EMAIL_FROM="Sift <hello@yourdomain.com>"


#-------------------------------------------------------------------------------
# SCHEDULED JOBS
# Two crons (see vercel.json): hourly analysis retries plus threshold-driven
# re-clustering, and the Monday morning digest. Without this secret /api/cron/*
# refuses to run, clustering only happens when triggered from the UI, and no
# digests go out.
#-------------------------------------------------------------------------------

# Any long random string.  openssl rand -hex 24
CRON_SECRET=""


#-------------------------------------------------------------------------------
# BILLING, subscription plans
# Without these, every organization stays on Free and checkout is disabled.
#-------------------------------------------------------------------------------

# dashboard.stripe.com/apikeys, use the test key (sk_test_...) while building.
STRIPE_SECRET_KEY=""

# Local development:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""

# Create one Product per paid plan in Stripe with a monthly and a yearly
# price, then paste the price IDs (price_...) here. Free isn't a Stripe
# product. Check src/lib/site.ts's `plans` array for the current numbers,
# these drift as pricing changes:
#   Pro      $19/mo   $190/yr
#   Scale    $49/mo   $490/yr
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_SCALE_MONTHLY=""
STRIPE_PRICE_SCALE_ANNUAL=""
