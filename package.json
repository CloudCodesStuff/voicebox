{
  "name": "voicebox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:widget && next dev",
    "build": "npm run build:widget && prisma generate && next build",
    "build:widget": "node scripts/build-widget.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset",
    "env:check": "tsx scripts/check-env.ts",
    "setup": "tsx scripts/check-env.ts && prisma migrate deploy && tsx prisma/seed.ts",
    "analyze": "tsx --tsconfig tsconfig.scripts.json scripts/analyze.ts",
    "keys": "tsx --tsconfig tsconfig.scripts.json scripts/keys.ts",
    "playground": "tsx --tsconfig tsconfig.scripts.json scripts/playground.ts",
    "seed:owner": "tsx --tsconfig tsconfig.scripts.json scripts/seed-owner.ts",
    "inspect": "tsx --tsconfig tsconfig.scripts.json scripts/inspect.ts",
    "refresh:widget": "tsx --tsconfig tsconfig.scripts.json scripts/refresh-widget-copy.ts",
    "smoke:api": "tsx --tsconfig tsconfig.scripts.json scripts/smoke-api.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.27",
    "@auth/prisma-adapter": "^2.11.3",
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "ai": "^7.0.59",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.19.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.8",
    "stripe": "^22.5.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
